+"""Pure regional sampling policy; no I/O, credentials or budget implementation."""
+from calendar import monthrange
+from datetime import date, datetime, time, timedelta, timezone
+from zoneinfo import ZoneInfo
+import os
+import math
+
+
+def enabled():
+    return os.getenv('MOBILITY_TOMTOM_ADAPTIVE_SAMPLING_ENABLED', 'false').lower() == 'true'
+
+
+def _minute(value):
+    parts = str(value).split(':')
+    if len(parts) != 2 or any(not p.isascii() or not p.isdigit() for p in parts):
+        raise ValueError('invalid schedule time')
+    hour, minute = map(int, parts)
+    if not 0 <= hour <= 24 or not 0 <= minute < 60 or (hour == 24 and minute):
+        raise ValueError('invalid schedule time')
+    return hour * 60 + minute
+
+
+def validate(config):
+    if not isinstance(config, dict) or not config.get('version'):
+        raise ValueError('explicit regional sampling configuration required')
+    for product in ('flow', 'incident'):
+        seen = {d: [] for d in range(7)}
+        for w in config.get(product, []):
+            a, b = _minute(w['start']), _minute(w['end'])
+            interval = w['interval_minutes']
+            if type(interval) is not int or not 5 <= interval <= 1440 or not a < b:
+                raise ValueError('invalid half-open sampling window')
+            if not w.get('days') or any(type(d) is not int or d not in seen for d in w['days']):
+                raise ValueError('invalid weekday set')
+            for d in w['days']:
+                if any(a < y and b > x for x, y in seen[d]):
+                    raise ValueError('overlapping sampling windows')
+                seen[d].append((a, b))
+    holidays = config.get('holidays')
+    if holidays is not None:
+        if not holidays.get('source_ref') or not holidays.get('covered_years'):
+            raise ValueError('holiday calendar needs provenance/year coverage')
+        for value in holidays.get('dates', []):
+            if date.fromisoformat(value).year not in holidays['covered_years']:
+                raise ValueError('holiday outside reviewed calendar coverage')
+        holiday_config = {'version': 'holiday', **{p: [{**w, 'days': list(range(7))}
+            for w in holidays.get(p, [])] for p in ('flow', 'incident')}}
+        validate(holiday_config)
+    if type(config.get('incident_queries_per_cycle', 1)) is not int or config.get('incident_queries_per_cycle', 1) < 1:
+        raise ValueError('invalid incident query multiplicity')
+    for name in ('flow_freshness_seconds','trend_max_gap_seconds','trend_max_projection_seconds','history_refresh_seconds'):
+        value=config.get(name,600)
+        if type(value) is not int or not 0<value<=86400:
+            raise ValueError('invalid temporal model bound')
+    for name in ('trend_max_projection_fraction','minimum_change_fraction'):
+        value=config.get(name,.1)
+        if isinstance(value,bool) or not isinstance(value,(int,float)) or not math.isfinite(value) or not 0<=value<=1:
+            raise ValueError('invalid modeled change criterion')
+    return config
+
+
+def configuration(region):
+    return validate((region.motion or {}).get('traffic_sampling'))
+
+
+def windows(config, day, product):
+    holidays = config.get('holidays')
+    if holidays is not None:
+        if day.year not in holidays['covered_years']:
+            return [], 'HOLIDAY_CALENDAR_YEAR_UNVERIFIED'
+        if day.isoformat() in holidays.get('dates', []):
+            return holidays.get(product, []), 'REVIEWED_HOLIDAY_CALENDAR'
