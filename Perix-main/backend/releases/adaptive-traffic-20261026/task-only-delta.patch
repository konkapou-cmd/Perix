+"""Causal road-condition changes, not vehicle observations or a filled series."""
+from datetime import datetime, timezone
+import math
+import os
+import statistics
+
+
+def enabled():
+    return os.getenv('MOBILITY_TOMTOM_TRENDS_ENABLED', 'false').lower() == 'true'
+
+
+def aware(value):
+    if isinstance(value, str):
+        value = datetime.fromisoformat(value)
+    return value.replace(tzinfo=timezone.utc) if value.tzinfo is None else value
+
+
+def summarize(rows, edge_id, when, config):
+    samples = []
+    for row in rows:
+        item = row.get('by_edge', {}).get(edge_id)
+        if not item or not item.get('direction_binding_id'):
+            continue
+        fetched = aware(row['fetched_at'])
+        speed = item.get('expected_speed_kmh')
+        if (not isinstance(speed, (int,float)) or isinstance(speed,bool) or not math.isfinite(speed)
+                or speed <= 0 or fetched > when or aware(row['expires_at']) <= when):
+            continue
+        identity = (row.get('region_id'), row.get('network_id'), row.get('version_id'), row.get('osm_snapshot_v'),
+                    row.get('policy_id'), tuple(sorted(row.get('generation_ids', []))), item['direction_binding_id'])
+        samples.append((fetched, speed, identity))
+    samples.sort(key=lambda s:s[0], reverse=True)
+    if not samples:
+        return {'state':'NO_COMPARABLE_OBSERVATION','supported':False,'samples':0}
+    identity = samples[0][2]
+    unique = {}
+    for stamp,speed,binding in samples:
+        if binding == identity:
+            unique.setdefault(stamp, speed)
+    recent = sorted(unique.items(), reverse=True)[:3]
+    report = {'state':'INSUFFICIENT_COMPARABLE_SAMPLES','supported':False,'samples':len(recent),
+              'age_basis':'RECEIPT_ONLY','interpolated_observations':0}
+    if len(recent) < 2:
+        return report
+    gaps = [(a[0]-b[0]).total_seconds() for a,b in zip(recent,recent[1:])]
+    if any(not 0 < gap <= config.get('trend_max_gap_seconds',900) for gap in gaps):
+        return {**report,'state':'GAPPED_OBSERVATIONS'}
+    changes = [(a[1]-b[1])/b[1] for a,b in zip(recent,recent[1:])]
+    report.update(last_change_fraction=changes[0], informational_change=abs(changes[0]) >= config.get('minimum_change_fraction',.1))
+    if len(recent) < 3:
+        return report
+    slopes = [(a[1]-b[1])/gap for (a,b),gap in zip(zip(recent,recent[1:]),gaps)]
+    if slopes[0]*slopes[1] < 0:
+        return {**report,'state':'REVERSAL_UNCERTAIN',
+                'latest_change':'RECOVERING' if slopes[0]>0 else 'SLOWING'}
+    if not all(abs(c) >= config.get('minimum_change_fraction',.1) for c in changes):
+        return {**report,'state':'STABLE_OR_SMALL_CHANGE'}
+    return {**report,'supported':True,'state':'RECOVERING' if slopes[0]>0 else 'SLOWING',
+            'modeled_rate_kmh_per_second':statistics.median(slopes),
+            'latest_receipt':recent[0][0].isoformat(), 'latest_observed_road_speed_kmh':recent[0][1]}
+
+
+def projected_speed(evidence, offset_s, config):
+    """Bounded shadow hypothesis; never relabel the result as a measurement."""
+    trend = evidence.get('temporal_change') or {}
+    latest = evidence['expected_speed_kmh']
+    if not trend.get('supported') or not 0 < offset_s <= config.get('trend_max_projection_seconds',300):
+        return latest, 'LATEST_ONLY_UNCERTAIN_OR_BEYOND_HORIZON'
+    if evidence.get('age_seconds',0)+offset_s >= config.get('flow_freshness_seconds',600):
+        return latest, 'PROJECTION_OUTSIDE_FRESHNESS'
+    fraction = max(0., min(.25, config.get('trend_max_projection_fraction',.15)))
+    proposed = latest + trend['modeled_rate_kmh_per_second'] * offset_s
+    value = min(latest*(1+fraction), max(latest*(1-fraction), proposed))
+    value = min(value, evidence.get('free_flow_speed_kmh',value))
+    return value, 'MODELED_TEMPORAL_HYPOTHESIS_NOT_BUS_SPEED'
+
+
+def prioritize(points, rows, now, config):
+    """Keep original ordinal indices despite ordering/optional omissions."""
+    result=[]
+    for index,point in enumerate(points):
+        relevant=[r for r in rows if r.get('point_id')==point['point_id'] and r.get('by_edge')
+                  and r.get('version_id')==point.get('version_id') and r.get('osm_snapshot_v')==point.get('osm_snapshot_v')
+                  and set(r.get('generation_ids',[])).intersection(point.get('generation_ids',[]))
+                  and all(e.get('direction_binding_id') or e.get('reason')=='DIRECTED_GEOMETRY_AND_REVIEWED_OPENLR'
+                          for e in r['by_edge'].values())
+                  and aware(r['fetched_at'])<=now and aware(r['expires_at'])>now]
+        relevant.sort(key=lambda r:aware(r['fetched_at']),reverse=True)
+        age=(now-aware(relevant[0]['fetched_at'])).total_seconds() if relevant else None
+        demand=point.get('scheduled_bus_demand')
+        count=demand.get('scheduled_passes') if isinstance(demand,dict) else None
+        active=demand.get('active_scheduled_trips') if isinstance(demand,dict) else None
+        changes=[summarize(relevant,e,now,config) for e in (relevant[0]['by_edge'] if relevant else [])]
+        changed=any(c.get('informational_change') for c in changes)
+        skip=(config.get('skip_without_bus_demand') is True and count==0 and age is not None
+              and demand.get('active_forecasts_checked') is True
+              and demand.get('active_scheduled_trips',0)==0
+              and age < min(config.get('history_refresh_seconds',1200),config.get('flow_freshness_seconds',600))
+              and len(relevant)>=2 and not changed)
+        reason=('NO_SCHEDULED_BUS_RECENT_HISTORY_PRESERVED' if skip else 'NO_ACCEPTED_HISTORY' if age is None
+                else 'CHANGED_TRAFFIC' if changed else 'SCHEDULED_BUS_DEMAND' if count else 'DEMAND_UNKNOWN_OR_COVERAGE_REFRESH')
+        result.append({'ordinal':index,'point':point,'skip':skip,'reason':reason,'accepted_age_seconds':age,
+            'scheduled_passes':count,'changed':changed,
+            'active_scheduled_forecasts_proxy':active,
+            'priority':(count or 0,active or 0,changed,age is None,age or 0)})
+    return sorted(result,key=lambda r:r['priority'],reverse=True)
+
+
+def scheduled_demand(plan, network, domain, bundles, when, horizon_s, region):
+    """Scheduled passage interpolation, not observed bus position or GPS.
+
+    Use exact stop-pair occurrences and GTFS seconds. Missing/ambiguous timing
+    is unknown, never a zero-demand reason to omit a measurement.
+    """
+    from zoneinfo import ZoneInfo
+    from utils.gtfs import _time_seconds
+    from datetime import date, timedelta
+    zone=ZoneInfo(region.timezone)
+    start=when.astimezone(zone);end=(when+timedelta(seconds=horizon_s)).astimezone(zone)
+    service_date=network.get('service_date') or (domain.get('network') or {}).get('service_date')
+    try:
+        day=date.fromisoformat(service_date)
+    except (TypeError,ValueError):
+        return {p['point_id']:{'scheduled_passes':None,'active_forecasts_checked':False,
+            'basis':'UNKNOWN_SERVICE_DATE','service_date':service_date} for p in plan['points']}
+    low=(start.date()-day).days*86400+start.hour*3600+start.minute*60+start.second
+    high=(end.date()-day).days*86400+end.hour*3600+end.minute*60+end.second
+    trips={str(t['trip_id']):t for r in network.get('routes',[]) for t in r.get('trips',[])}
+    patterns={b['pattern_id']:b for b in bundles if b.get('ready') and b.get('version_id')==network['version_id']}
+    result={}
+    for point in plan['points']:
+        count=0;active=0;unknown=high<low
+        for template in domain.get('trip_templates',[]):
+            if template.get('mode')!='bus' or template.get('pattern_id') not in point['pattern_ids']:
+                continue
+            bundle=patterns.get(template['pattern_id']);trip=trips.get(str(template['trip_id']))
+            if not bundle or not trip:
+                unknown=True;continue
+            edges=(bundle.get('infrastructure') or {}).get('edges',[])
+            matching=[e for e in edges if str(e['edge_id'])==str(point['edge_id'])]
+            for edge in matching:
+                try:
+                    visits=trip['stop_times_sequence'];a,b=edge['a_idx'],edge['b_idx']
+                    departure=_time_seconds(visits[a]['departure_time'],'sampling departure')
+                    arrival=_time_seconds(visits[b]['arrival_time'],'sampling arrival')
+                    pair=[e for e in edges if e.get('a_idx')==a and e.get('b_idx')==b]
+                    first,last=min(e['from_m'] for e in pair),max(e['to_m'] for e in pair)
+                    ratio=((edge['from_m']+edge['to_m'])/2-first)/(last-first)
+                    passage=departure+ratio*(arrival-departure)
+                    count+=low<=passage<high
+                    active+=low<=passage<high and (template.get('start') or 0)<=low<(template.get('end') or 0)
+                except (KeyError,IndexError,ValueError,ZeroDivisionError,TypeError):
+                    unknown=True
+        result[point['point_id']]={'scheduled_passes':None if unknown else count,
+            'active_scheduled_trips':None if unknown else active,
+            'active_forecasts_checked':False,
+            'basis':'UNKNOWN_TIMING' if unknown else 'SCHEDULED_INTERPOLATED_NOT_OBSERVED',
+            'horizon_seconds':horizon_s,'service_date':service_date}
+    return result
