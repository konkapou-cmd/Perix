+"""Bus-only shadow allocation: spatial slack and residual-time hypotheses.
+
+All states come from the existing full physical builders. This does not locate
+a real bus, rewrite its handover or infer a real queue/red phase.
+"""
+import os
+from mobility.motion.common import sample_trajectory, trajectory_time_at_progress
+from mobility.tomtom_temporal import projected_speed
+
+
+def enabled():
+    return os.getenv('MOBILITY_BUS_TIME_EVIDENCE_ENABLED','false').lower()=='true'
+
+
+def compare(baseline, fitted, builder, target, *, infra, start_m, end_m,
+            evidence, initial_speed_kmh=0., elapsed_s=None, physics_config=None):
+    edges=infra.get('edges') or []
+    usable={str(e['edge_id']):e for e in edges if e.get('from_m',-1)>=start_m
+        and e.get('to_m',end_m+1)<=end_m and e['to_m']>e['from_m']}
+    direct={key:value for key,value in evidence.items() if key in usable and value.get('direction_binding_id')
+        and value.get('free_flow_speed_kmh',0)>0
+        and value['expected_speed_kmh']<value['free_flow_speed_kmh']*.9}
+    report={'shadow_only':True,'model':'BUS_SPATIAL_REMAINING_TIME_V1','available':False,
+            'source':'ROAD_CONDITIONS_NOT_VEHICLE_GPS','evidence_edge_ids':sorted(direct),
+            'reason':None,'queries':[],
+            'uncertainty_status':'NOT_IDENTIFIABLE_AS_A_UNIQUE_OBSERVED_POSITION',
+            'range_is_evaluated_scenarios_not_confidence_interval':True}
+    if not direct:
+        report['reason']='NO_VERIFIED_FULL_FUTURE_EDGE_BEFORE_STOP'
+        return report
+
+    def localize(values):
+        def build(factor):
+            return builder({'refine_turns':True,'slow_edge_ids':list(values),'speed_factor':factor},values)
+        natural=build(1.)
+        if not 0<natural.get('duration_s',0)<=target:
+            return None
+        free=builder({'refine_turns':True}, {})
+        evidenced_cost=max(0.,natural['duration_s']-free['duration_s'])
+        # A slow road is not a license to assign arbitrarily much unknown slack
+        # there. This is a declared hypothesis allowance, not TomTom confidence
+        # interpreted as a probability or a measured error bar.
+        if target-natural['duration_s']>max(2.,.5*evidenced_cost):
+            return None
+        low,high=.05,1.
+        slow=build(low)
+        if slow.get('duration_s',0)<target:
+            return None  # Cannot justify all residual slack on these edges.
+        best=natural
+        for _ in range(18):
+            factor=(low+high)/2
+            candidate=build(factor)
+            if candidate['duration_s']>target:
+                low=factor
+            else:
+                best=candidate;high=factor
+        scale=max(1.,target/best['duration_s'])
+        first=best['segments'][0]['v0']*3.6/scale
+        if abs(first-initial_speed_kmh)>.05:
+            return None
+        return {'trajectory':best,'time_scale':scale,'speed_factor':high,
+                'unallocated_roundoff_s':target-best['duration_s'],
+                'road_evidence_cost_s':evidenced_cost,'additional_hypothesis_slack_s':target-natural['duration_s']}
+
+    localized=localize(direct)
+    if localized is None:
+        report['reason']='NO_COMPATIBLE_LOCAL_ALLOCATION_KEEP_BASELINE'
+        return report
+    modeled={};projection_reasons={}
+    for key,value in direct.items():
+        offset=trajectory_time_at_progress(baseline['trajectory'],usable[key]['from_m'])*baseline['time_scale']
+        speed,reason=projected_speed(value,offset,value.get('temporal_config') or {})
+        modeled[key]={**value,'expected_speed_kmh':speed,'modeled_not_observed':True}
+        projection_reasons[key]=reason
+    trend=localize(modeled) if any(modeled[k]['expected_speed_kmh']!=direct[k]['expected_speed_kmh'] for k in direct) else None
+    alternatives={'BASELINE':baseline,'LATEST_UNIFORM':fitted,'LOCALIZED_LATEST':localized}
+    if trend is not None:
+        alternatives['LOCALIZED_TREND_HYPOTHESIS']=trend
+    queries=[target*r for r in (.25,.5,.75)]
+    if elapsed_s is not None and 0<=elapsed_s<target:
+        queries.append(elapsed_s)
+    for elapsed in sorted(set(queries)):
+        candidates=[]
+        for name,model in alternatives.items():
+            state=sample_trajectory(model['trajectory'],elapsed,model['time_scale'])
+            position,speed=state['progress_m'],state['speed_kmh']
+            if not start_m<=position<end_m:
+                continue
+            tail_scenario={'refine_turns':True,'candidate_start_m':position,
+                           'candidate_initial_speed_kmh':speed}
+            values=modeled if name=='LOCALIZED_TREND_HYPOTHESIS' else direct
+            if name.startswith('LOCALIZED'):
+                tail_scenario.update(slow_edge_ids=list(values),speed_factor=model['speed_factor'])
+            tail=builder(tail_scenario,values)
+            physical=builder({**tail_scenario,'slow_edge_ids':[], 'candidate_recovery_ratio':1.},{})
+            remaining=target-elapsed
+            actual_initial=(tail.get('segments') or [{}])[0].get('v0',0)*3.6
+            residual=tail.get('duration_s',0)-remaining
+            # Tail rebuilding re-anchors the existing spatial integration grid.
+            # Report its bounded comparison tolerance instead of pretending
+            # those few seconds are measured traffic/arrival uncertainty.
+            cell=max((s['p1']-s['p0'] for s in model['trajectory'].get('segments',[])),default=5.)
+            positive=[v for s in tail.get('segments',[]) for v in (s['v0'],s['v1']) if v>0]
+            grid_tolerance=max(2.,min(5.,cell/min(positive))) if positive else 2.
+            compatible=(physical.get('duration_s',0)<=remaining+grid_tolerance
+                        and abs(actual_initial-speed)<=.05 and abs(residual)<=grid_tolerance)
+            candidates.append({'source':name,'progress_m':position,'speed_kmh':speed,
+                'remaining_target_s':remaining,'remaining_physical_min_s':physical['duration_s'],
+                'remaining_with_evidence_s':tail['duration_s'],'residual_s':residual,
+                'tail_rebuild_grid_tolerance_s':grid_tolerance,
+                'compatible_with_time_evidence':compatible,
+                'past_compatible_by_constructed_trajectory':True,'observed_vehicle_state':False})
+        valid=[c for c in candidates if c['compatible_with_time_evidence'] and c['source'].startswith('LOCALIZED')]
+        latest_choice=next((c for c in valid if c['source']=='LOCALIZED_LATEST'),None)
+        trend_choice=next((c for c in valid if c['source']=='LOCALIZED_TREND_HYPOTHESIS'),None)
+        resolution=max((s['p1']-s['p0'] for s in localized['trajectory']['segments']),default=5.)
+        meaningful_trend=bool(trend_choice and (not latest_choice or abs(trend_choice['progress_m']-latest_choice['progress_m'])>=resolution))
+        preferred=trend_choice if meaningful_trend else latest_choice or trend_choice
+        report['queries'].append({'elapsed_s':elapsed,'candidates':candidates,
+            'trend_materially_changes_evaluated_position':meaningful_trend,
+            'preferred_shadow':preferred,'compatible_position_range_m':
+            [min(c['progress_m'] for c in valid),max(c['progress_m'] for c in valid)] if valid else None})
+    report.update(available=True,reason='BOUNDED_LOCAL_ALLOCATION_NOT_UNIQUE_POSITION_PROOF',
+                  projection_reasons=projection_reasons,eta_delta_s=0.,
+                  road_evidence_cost_s=localized['road_evidence_cost_s'],
+                  additional_hypothesis_slack_s=localized['additional_hypothesis_slack_s'])
+    violations=backward=0
+    for model in [localized]+([trend] if trend else []):
+        previous=None
+        for segment in model['trajectory']['segments']:
+            ds=segment['p1']-segment['p0'];dt=segment['t1']-segment['t0']
+            backward+=ds<0
+            if previous and abs(segment['p0']-previous['p1'])>1e-5:
+                violations+=1
+            if physics_config and ds>=0:
+                violations+=segment['v1']**2>segment['v0']**2+2*physics_config['acceleration_mps2']*ds+1e-5
+                violations+=segment['v0']**2>segment['v1']**2+2*physics_config['braking_mps2']*ds+1e-5
+            previous=segment
+    report['construction_checks']={'physics_violations':violations if physics_config else None,
+                                   'backward_phase_samples':backward,'independent_accuracy':None}
+    return report
