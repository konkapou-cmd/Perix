+class Store:
+    def __init__(self):self.rows=[];self.writes=0
+    def find(self,scope,*args):
+        return Cursor([r for r in self.rows if all((r.get(k)>v['$gt'] if isinstance(v,dict) else r.get(k)==v) for k,v in scope.items())])
+    async def replace_one(self,query,record,upsert=False):
+        self.writes+=1
+        for i,row in enumerate(self.rows):
+            if all(row.get(k)==v for k,v in query.items()):self.rows[i]=deepcopy(record);break
+        else:self.rows.append(deepcopy(record))
