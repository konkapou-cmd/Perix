+def observation(now,seconds_ago,speed,binding='verified-synthetic'):
+    return {'point_id':'p','region_id':'r','network_id':'n','version_id':'v','osm_snapshot_v':3,
+        'generation_ids':['g'],'policy_id':'policy','fetched_at':now-timedelta(seconds=seconds_ago),
+        'expires_at':now-timedelta(seconds=seconds_ago)+timedelta(seconds=1200),
+        'by_edge':{'edge':{'expected_speed_kmh':speed,'direction_binding_id':binding,'provider':'TOMTOM_FLOW',
+                        'free_flow_speed_kmh':50.}}}
+
+
+@pytest.mark.parametrize('speeds,state',[( [30,20,10],'SLOWING'),([10,20,30],'RECOVERING')])
+def test_causal_comparable_road_trends(speeds,state):
+    now=datetime.now(timezone.utc)
+    rows=[observation(now,age,speed) for age,speed in zip((600,300,0),speeds)]
+    report=temporal.summarize(rows,'edge',now,{})
+    assert report['supported'] and report['state']==state and report['interpolated_observations']==0
+    evidence={**rows[-1]['by_edge']['edge'],'temporal_change':report,'age_seconds':0}
+    predicted,reason=temporal.projected_speed(evidence,60,{})
+    assert reason=='MODELED_TEMPORAL_HYPOTHESIS_NOT_BUS_SPEED'
+    assert predicted<speeds[-1] if state=='SLOWING' else predicted>speeds[-1]
+
+
+def test_reversal_single_outlier_gaps_future_and_binding_changes_not_a_series():
+    now=datetime.now(timezone.utc)
+    rows=[observation(now,a,s) for a,s in zip((600,300,0),(30,10,20))]
+    report=temporal.summarize(rows,'edge',now,{})
+    assert not report['supported'] and report['latest_change']=='RECOVERING'
+    assert temporal.projected_speed({**rows[-1]['by_edge']['edge'],'temporal_change':report},60,{})[0]==20
+    rows[0]['fetched_at']=now-timedelta(seconds=1100)
+    assert not temporal.summarize(rows,'edge',now,{'trend_max_gap_seconds':400})['supported']
+    rows[0]['fetched_at']=now+timedelta(seconds=1)
+    assert temporal.summarize(rows,'edge',now,{})['samples']==2
+    rows[1]['by_edge']['edge']['direction_binding_id']='different'
+    assert not temporal.summarize(rows,'edge',now,{})['supported']
