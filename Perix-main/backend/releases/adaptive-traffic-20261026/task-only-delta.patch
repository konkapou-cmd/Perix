+def opportunity(config, region, when, product):
+    if when.utcoffset() is None:
+        raise ValueError('aware scheduler clock required')
+    local = when.astimezone(ZoneInfo(region.timezone))
+    choices, basis = windows(config, local.date(), product)
+    minute = local.hour * 60 + local.minute
+    for w in choices:
+        a, b = _minute(w['start']), _minute(w['end'])
+        if a <= minute < b:
+            nominal = a + ((minute - a) // w['interval_minutes']) * w['interval_minutes']
+            start = _utc(local.date(), nominal, ZoneInfo(region.timezone), local.fold)
+            if start is None:
+                return None
+            # No fold, policy version or priority in the id: restart, repeated
+            # autumn wall time and configuration changes cannot reopen it.
+            return {'slot': f"adaptive:{region.region_id}:{local.date().isoformat()}:{nominal:04d}",
+                'nominal_utc': start, 'interval_seconds': w['interval_minutes'] * 60,
+                'local_window': [w['start'], w['end']], 'basis': basis,
+                'timezone': region.timezone, 'policy_version': config['version']}
+    return None
+
+
+def slots_for_day(config, region, day, product):
+    choices, _ = windows(config, day, product)
+    out = {}
+    zone = ZoneInfo(region.timezone)
+    for w in choices:
+        for minute in range(_minute(w['start']), _minute(w['end']), w['interval_minutes']):
+            instants = [u for f in (0, 1) if (u := _utc(day, minute, zone, f)) is not None]
+            if instants:
+                out[(day.isoformat(), minute)] = (instants, w['interval_minutes'] * 60)
+    return out
+
+
+def period_usage(config, region, start, end, points=6):
+    """Exact nominal monthly slots; conservative partial-slot account admission.
+
+    Repeated wall slots count once. No missed-cycle catch-up. Retries excluded.
+    """
+    if start.utcoffset() is None or end.utcoffset() is None or not start < end or end-start > timedelta(days=33):
+        raise ValueError('invalid forecast period')
+    zone = ZoneInfo(region.timezone)
+    day, last = start.astimezone(zone).date(), (end-timedelta(microseconds=1)).astimezone(zone).date()
+    totals = {'flow': 0, 'incident': 0}
+    uncovered = False
+    while day <= last:
+        for product in totals:
+            _, basis = windows(config, day, product)
+            uncovered |= basis == 'HOLIDAY_CALENDAR_YEAR_UNVERIFIED'
+            for instants, seconds in slots_for_day(config, region, day, product).values():
+                if any(u < end and u + timedelta(seconds=seconds) > start for u in instants):
+                    totals[product] += points if product == 'flow' else config.get('incident_queries_per_cycle', 1)
+        day += timedelta(days=1)
+    return {**totals, 'retries_included': False, 'holiday_coverage_complete': not uncovered}
+
+
+def monthly_usage(config, region, year, month, points=6):
+    zone = ZoneInfo(region.timezone)
+    start = datetime(year, month, 1, tzinfo=zone)
+    end = start + timedelta(days=monthrange(year, month)[1])
+    return period_usage(config, region, start, end, points)
+
+
+def admission(config, region, policy, points):
+    usage = period_usage(config, region, datetime.fromisoformat(policy['period_start']),
+                         datetime.fromisoformat(policy['period_end']), points)
+    ok = (usage['holiday_coverage_complete'] and usage['flow'] <= min(15000, policy['flow_cap'])
+          and usage['incident'] <= min(2000, policy['incident_cap'])
+          and config.get('incident_queries_per_cycle', 1) == 1)
+    return {'admitted': ok, 'usage': usage,
+            'reason': 'SCHEDULE_FITS_INTERNAL_LIMITS' if ok else 'COST_CALENDAR_OR_MULTIBBOX_REVIEW_REQUIRED'}
