-from datetime import datetime, timezone
-import hashlib
-import json
-from pymongo import ReturnDocument
-from pymongo.errors import DuplicateKeyError
-
-FLOW_CAP = 15000
-INCIDENT_CAP = 2000
-LEASE_MS = 90000
-REQUEST_MARGIN_MS = 15000
-
-
-class TrafficControl:
-    def __init__(self, collection, policy):
-        self.collection, self.policy = collection, policy
-        self.key = 'tomtom:' + policy['account_ref']
-        self.policy_id = hashlib.sha256(json.dumps(policy, sort_keys=True).encode()).hexdigest()
-
-    async def initialize(self):
-        try:
-            await self.collection.update_one({'_id': self.key}, {'$setOnInsert': {
-                'policy_id': self.policy_id, 'period_start': self.policy['period_start'],
-                'period_end': self.policy['period_end'], 'used': {'flow': 0, 'incident': 0},
-                'reservations': {}, 'halted': False, 'epoch': 0,
-                'lease_owner': None, 'lease_until': datetime(2000, 1, 1, tzinfo=timezone.utc),
-            }}, upsert=True)
-        except DuplicateKeyError:
-            pass
-
-    def _period(self):
-        return [{'$lte': [datetime.fromisoformat(self.policy['period_start']), '$$NOW']},
-                {'$gt': [datetime.fromisoformat(self.policy['period_end']), '$$NOW']}]
-
-    async def acquire(self, owner):
-        await self.initialize()
-        query = {'_id': self.key, 'policy_id': self.policy_id, 'halted': False,
-                 '$expr': {'$and': self._period() + [{'$or': [
-                     {'$eq': ['$lease_owner', {'$literal': owner}]}, {'$lte': ['$lease_until', '$$NOW']}]}]}}
-        return await self.collection.find_one_and_update(query, [{'$set': {
-            'epoch': {'$add': ['$epoch', {'$cond': [{'$eq': ['$lease_owner', {'$literal': owner}]}, 0, 1]}]},
-            'lease_owner': {'$literal': owner}, 'lease_until': {'$add': ['$$NOW', LEASE_MS]},
-        }}], return_document=ReturnDocument.AFTER)
-
-    async def reserve(self, lease, kind, slot):
-        if kind not in ('flow', 'incident') or not lease:
-            return False
-        token = hashlib.sha256((kind + ':' + slot).encode()).hexdigest()
-        maximum = min(FLOW_CAP if kind == 'flow' else INCIDENT_CAP,
-                      int(self.policy[kind + '_cap']))
-        query = {'_id': self.key, 'policy_id': self.policy_id, 'halted': False,
-                 'lease_owner': lease['lease_owner'], 'epoch': lease['epoch'],
-                 'reservations.' + token: {'$exists': False}, '$expr': {'$and': self._period() + [
-                     {'$gt': ['$lease_until', {'$add': ['$$NOW', REQUEST_MARGIN_MS]}]},
-                     {'$lt': ['$used.' + kind, maximum]}]}}
-        result = await self.collection.update_one(query, {'$inc': {'used.' + kind: 1},
-            '$set': {'reservations.' + token: True}})
-        return result.modified_count == 1
-
-    async def halt(self, status):
-        if status in (401, 403, 429):
-            await self.collection.update_one({'_id': self.key}, {'$set': {
-                'halted': True, 'halt_status': status}})
-
-    async def status(self):
-        value = await self.collection.find_one({'_id': self.key}, {
-            '_id': 0, 'used': 1, 'halted': 1, 'halt_status': 1, 'period_start': 1,
-            'period_end': 1, 'lease_until': 1, 'epoch': 1})
-        return value or {'initialized': False}
