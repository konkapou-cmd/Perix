-
-def validate(config):
-    if not isinstance(config, dict) or not config.get('version'):
-        raise ValueError('explicit regional sampling configuration required')
-    for product in ('flow', 'incident'):
-        seen = {d: [] for d in range(7)}
-        for w in config.get(product, []):
-            a, b = _minute(w['start']), _minute(w['end'])
