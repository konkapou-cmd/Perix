-def _project(points, point):
-    """Finite-chain projection; caller checks every vertex and both directions."""
-    scale = 111320 * math.cos(math.radians(point[0]))
-    best, along, cumulative = math.inf, 0., 0.
-    for a, b in zip(points, points[1:]):
-        ax, ay = (a[1] - point[1]) * scale, (a[0] - point[0]) * 110540
-        bx, by = (b[1] - point[1]) * scale, (b[0] - point[0]) * 110540
-        dx, dy = bx - ax, by - ay
-        length = math.hypot(dx, dy)
-        ratio = max(0., min(1., -(ax * dx + ay * dy) / (length * length))) if length else 0.
-        distance = math.hypot(ax + ratio * dx, ay + ratio * dy)
-        if distance < best:
-            best, along = distance, cumulative + ratio * length
-        cumulative += length
-    return best, along
