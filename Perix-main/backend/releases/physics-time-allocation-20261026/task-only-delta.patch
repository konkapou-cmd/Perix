+        assert segment['v1'] ** 2 <= segment['v0'] ** 2 + 2 * config['acceleration_mps2'] * ds + 1e-6
+        assert segment['v0'] ** 2 <= segment['v1'] ** 2 + 2 * config['braking_mps2'] * ds + 1e-6
+        if previous:
