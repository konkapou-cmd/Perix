+"""Synthetic CPU/consistency benchmark; NOT observed ETA/position accuracy."""
+from collections import Counter
+import json
+from pathlib import Path
+import statistics
+import sys
+import time
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from mobility.motion.bus import build_bus_leg
+from mobility.motion.config import motion_config_for
+from mobility.motion.engine import _fit_leg
+from mobility.motion.time_allocation import allocate
+from mobility.motion.common import sample_trajectory
+
+
+def percentile(values,p):
+    return sorted(values)[min(len(values)-1,int((len(values)-1)*p))]
+
+
+def benchmark(iterations=40):
+    config=motion_config_for('bus')
+    edges=[dict(edge_id='1:1:2',from_node=1,to_node=2,from_m=0.,to_m=300.,
+        from_point=[0.,0.],to_point=[0.,.0027],way={'highway':'primary','maxspeed_kmh':40.,'follows_osm_way':True}),
+        dict(edge_id='2:2:3',from_node=2,to_node=3,from_m=300.,to_m=600.,
+        from_point=[0.,.0027],to_point=[.0027,.0027],way={'highway':'primary','maxspeed_kmh':40.,'follows_osm_way':True})]
+    infra={'edges':edges,'signals':[]}
+    original=dict(edges=edges,signals=[],start_m=0.,end_m=600.,departure_service_s=0.,config=config)
+    baseline_ms=[];research_ms=[];deltas=[];fallbacks=Counter();violations=0;backward=0;eta_delta=[]
+    for i in range(iterations):
+        target=[50.,100.,200.,400.][i%4]
+        start=time.perf_counter()
+        base=_fit_leg(lambda r:build_bus_leg(**original,traffic_by_edge={},recovery_ratio=r),target,10)
+        baseline_ms.append((time.perf_counter()-start)*1000)
+        def builder(scenario,evidence):return build_bus_leg(**original,traffic_by_edge=evidence,scenario=scenario)
+        start=time.perf_counter()
+        fitted,report=allocate(base,builder,target,infra=infra,mode='bus',start_m=0.,end_m=600.,config=config,
+            direct_by_edge={'2:2:3':{'provider':'TOMTOM_FLOW','expected_speed_kmh':15.,'includes_signal_delay':True}})
+        research_ms.append((time.perf_counter()-start)*1000)
+        fallbacks[report.get('fallback_reason') or 'SELECTED']+=1
+        scale=fitted['time_scale'];trajectory=fitted['trajectory']
+        for s in trajectory['segments']:
+            ds=s['p1']-s['p0']
+            if (ds<0 or s['v1']**2>s['v0']**2+2*config['acceleration_mps2']*ds+1e-5
+                    or s['v0']**2>s['v1']**2+2*config['braking_mps2']*ds+1e-5):violations+=1
+        end=trajectory['duration_s']*scale
+        previous=0.
+        for j in range(101):
+            p=sample_trajectory(trajectory,end*j/100,scale)['progress_m']
+            backward+=p<previous-1e-6;previous=p
+        for r in (.25,.5,.75):
+            deltas.append(abs(sample_trajectory(trajectory,target*r,scale)['progress_m']-
+                sample_trajectory(base['trajectory'],target*r,base['time_scale'])['progress_m']))
+        eta_delta.append(end-base['trajectory']['duration_s']*base['time_scale'])
+    return {'type':'SYNTHETIC_ENGINEERING_NOT_ACCURACY','iterations':iterations,
+        'baseline_fit_cpu_ms':{'p50':statistics.median(baseline_ms),'p95':percentile(baseline_ms,.95)},
+        'additional_research_cpu_ms':{'p50':statistics.median(research_ms),'p95':percentile(research_ms,.95)},
+        'baseline_new_position_delta_m':{'p50':statistics.median(deltas),'p95':percentile(deltas,.95)},
+        'maximum_absolute_eta_delta_s':max(map(abs,eta_delta)),'physics_violations':violations,
+        'backward_samples':backward,'fallback_counts':dict(fallbacks),
+        'direct_traffic_fixture_distance_coverage':.5,'actual_tomtom_requests':0,'actual_provider_coverage':0.,
+        'rejected_measurement_ratio':None,'request_budget_cost':{'flow':0,'incident':0},
+        'eta_mae_s':None,'independent_position_error_m':None,'api_latency_p50_p95':None,
+        'reason':'No independent observations or API load benchmark supplied'}
+
+
+if __name__=='__main__':
+    result=benchmark()
+    if len(sys.argv)>1:
+        output=Path(sys.argv[1]);assert not output.exists();output.write_text(json.dumps(result,indent=2))
+    print(json.dumps(result,indent=2))
