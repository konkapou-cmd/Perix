+                if not all(map(math.isfinite, (west,south,east,north))) or not -180 <= west < east <= 180 or not -85 <= south < north <= 85 or area > 10000:
+                    return None, 'INVALID_OR_OVERSIZED_BBOX'
+            except (ValueError, KeyError, AttributeError):
+                return None, 'INVALID_OR_OVERSIZED_BBOX'
+            params = {'bbox': params['bbox'], 'fields': INCIDENT_FIELDS, 'timeValidityFilter': 'present'}
+        else:
+            return None, 'UNSUPPORTED_PRODUCT'
+        for attempt in range(2):
+            if approval() != policy or os.getenv('TOMTOM_TRAFFIC_API_KEY', '').strip() != key:
+                return None, 'APPROVAL_OR_CREDENTIAL_CHANGED'
+            if not await self.control.reserve(lease, kind, slot + ':' + str(attempt)):
+                return None, 'BUDGET_LEASE_OR_SLOT_DENIED'
+            if approval() != policy or os.getenv('TOMTOM_TRAFFIC_API_KEY', '').strip() != key:
+                return None, 'APPROVAL_OR_CREDENTIAL_CHANGED'
+            try:
+                status, payload = await self.transport(path, params, key)
+            except Exception:
+                status, payload = 0, None
+            if status == 200:
+                return payload, 'RECEIVED'
+            if status in (401, 403, 429):
+                await self.control.halt(status)
+                return None, 'AUTH_OR_RATE_HALTED'
+            if status not in (0, 500, 502, 503, 504):
+                break
+        return None, 'TRANSPORT_OR_SERVICE_UNAVAILABLE'
