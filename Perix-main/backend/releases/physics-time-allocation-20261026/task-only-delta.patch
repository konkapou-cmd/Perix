+"""Globally leased sampler; never invoked by passenger polling or trip builds."""
+import asyncio
+from datetime import datetime, timedelta, timezone
+import hashlib
+import json
+import os
+import uuid
+
+from mobility.tomtom_control import TrafficControl
+from mobility.tomtom_traffic import TomTomClient, approval, flag, parse_flow, parse_incidents, match_flow, incident_geometry_diagnostics
+
+
+def policy_fingerprint(policy):
+    return hashlib.sha256(json.dumps(policy, sort_keys=True).encode()).hexdigest()
+
+
+async def cached_evidence(edges, when, *, region_id, network_id):
+    """Cache-only read. No HTTP, lease acquisition or budget mutation here."""
+    policy = approval(when)
+    if policy is None:
+        return {}, []
+    if (region_id, network_id) not in [tuple(s) for s in policy.get('allowed_scopes', [])]:
+        return {}, [{'source': 'NONE', 'reason': 'APPROVAL_SCOPE_MISMATCH'}]
+    # Explicit backend/backup retention permission is required, not inferred
+    # from a generic license boolean. No real persistence without this approval.
+    if policy.get('storage_backend') != 'MONGO_TTL' or policy.get('backup_retention_approved') is not True:
+        return {}, [{'source': 'NONE', 'reason': 'STORAGE_TERMS_NOT_APPROVED'}]
+    from database import db
+    scope = {'region_id': region_id, 'network_id': network_id, 'policy_id': policy_fingerprint(policy),
+             'expires_at': {'$gt': when.astimezone(timezone.utc)}}
+    rows = await db.mobility_tomtom_evidence.find(scope, {'_id': 0}).to_list(12)
+    wanted = {str(e.get('edge_id')) for e in edges if (e.get('way') or {}).get('highway')}
+    out, diagnostics = {}, []
+    for row in rows:
+        fetched = row['fetched_at']
+        if fetched.tzinfo is None:
+            fetched = fetched.replace(tzinfo=timezone.utc)
+        age = (when - fetched).total_seconds()
+        if not 0 <= age < policy['retention_seconds']:
+            continue
+        for edge_id, evidence in row.get('by_edge', {}).items():
+            if edge_id not in wanted:
+                continue
+            # Same directed id can reappear in another snapshot: require graph
+            # and generation identity on each incoming canonical edge.
+            edge = next(e for e in edges if str(e.get('edge_id')) == edge_id)
+            if (edge.get('_traffic_graph_v') != row['osm_snapshot_v']
+                    or edge.get('_traffic_version_id') != row['version_id']
+                    or edge.get('_traffic_generation_id') not in row['generation_ids']):
+                diagnostics.append({'source': 'TOMTOM_FLOW', 'reason': 'GENERATION_MISMATCH'})
+                continue
+            expiry = row['expires_at']
+            if expiry.tzinfo is None:
+                expiry = expiry.replace(tzinfo=timezone.utc)
+            out[edge_id] = {**evidence, 'age_seconds': age, 'fetched_at': fetched.isoformat(),
+                            'expires_at': expiry.isoformat(), 'data_version': row['version_id']}
+        diagnostics.extend(d for d in row.get('diagnostics', [])
+            if wanted.intersection(d.get('candidate_edge_ids', row.get('requested_edge_ids', []))))
+    return out, diagnostics
+
+
+async def sample_cycle(control, client, lease, plan, now, collection):
+    """Explicit plan only, <=6 points/20m and <=1 incident bbox/30m.
+
+    Reservations make duplicate scheduler ticks idempotent. Retries reserve a
+    distinct attempt. Point choices do not change per HTTP call.
+    """
+    policy = approval(now)
+    if policy is None or policy != control.policy:
+        return {'requests': 0, 'reason': 'DISABLED_OR_UNAPPROVED'}
+    if policy.get('storage_backend') != 'MONGO_TTL' or policy.get('backup_retention_approved') is not True:
+        return {'requests': 0, 'reason': 'STORAGE_TERMS_NOT_APPROVED'}
+    points = plan.get('points') or []
+    if len(points) > 6 or not points or len({p['point_id'] for p in points}) != len(points):
+        return {'requests': 0, 'reason': 'INVALID_SIX_POINT_PLAN'}
+    # Configuration changes may not obtain another six calls in the same slot:
+    # reservation identity is an ordinal, independent of point/region changes.
+    slot = int(now.timestamp()) // 1200
+    stored = 0
+    for index, point in enumerate(points):
+        if (point.get('region_id'), point.get('network_id')) not in [tuple(s) for s in policy.get('allowed_scopes', [])]:
+            continue
+        payload, reason = await client.request(lease, 'flow', {'point': ','.join(map(str, point['point']))}, f'{slot}:{index}')
+        if reason == 'BUDGET_LEASE_OR_SLOT_DENIED':
+            continue  # Duplicate tick must not erase an accepted fresh sample.
+        by_edge = {}
+        if payload is not None:
+            try:
+                by_edge, reason = await asyncio.to_thread(match_flow, parse_flow(payload), point, plan.get('chains') or [],
+                    max_distance_m=float(policy.get('match_max_distance_m', 15.)),
+                    min_confidence=float(policy.get('match_min_confidence', .7)))
+            except (ValueError, KeyError, TypeError):
+                reason = 'INVALID_V4_PAYLOAD'
+        receipt = datetime.now(timezone.utc)
+        if approval(receipt) != policy:
+            return {'accepted_points':stored,'configured_points':len(points),'reason':'APPROVAL_CHANGED_DISCARDED'}
+        record = {'point_id': point['point_id'], 'region_id': point['region_id'], 'network_id': point['network_id'],
+            'version_id': point['version_id'], 'osm_snapshot_v': point['osm_snapshot_v'],
+            'generation_ids': point['generation_ids'], 'policy_id': policy_fingerprint(policy),
+            'fetched_at': receipt, 'expires_at': min(receipt + timedelta(seconds=policy['retention_seconds']),
+                datetime.fromisoformat(policy['approval_expires']), datetime.fromisoformat(policy['period_end'])),
+            'by_edge': by_edge, 'diagnostics': [{'source': 'TOMTOM_FLOW', 'reason': reason}]}
+        record['requested_edge_ids'] = [str(e['edge_id']) for c in plan.get('chains', [])
+                                       if c.get('chain_id') == point['chain_id'] for e in c['edges']]
+        # Only normalized approved evidence, never raw authenticated responses.
+        await collection.replace_one({'point_id': point['point_id']}, record, upsert=True)
+        stored += bool(by_edge)
+    if plan.get('incident_bbox'):
+        payload, reason = await client.request(lease, 'incident', {'bbox': ','.join(map(str, plan['incident_bbox']))},
+                                               str(int(now.timestamp()) // 1800))
+        # Incidents are diagnostic only; never sum their delay onto RT or flow.
+        if reason == 'BUDGET_LEASE_OR_SLOT_DENIED':
+            return {'accepted_points': stored, 'configured_points': len(points)}
+        if approval() != policy:
+            return {'accepted_points':stored,'configured_points':len(points),'reason':'APPROVAL_CHANGED_DISCARDED'}
+        incidents = parse_incidents(payload, datetime.now(timezone.utc)) if payload else []
+        # No redistribution of raw geometry/incident text via passenger APIs.
+        await collection.replace_one({'point_id': 'incidents'}, {'point_id': 'incidents',
+            'region_id': points[0]['region_id'], 'network_id': points[0]['network_id'],
+            'version_id': points[0]['version_id'], 'osm_snapshot_v': points[0]['osm_snapshot_v'],
+            'generation_ids': points[0]['generation_ids'], 'policy_id': policy_fingerprint(policy),
+            'fetched_at': now, 'expires_at': min(now + timedelta(seconds=policy['retention_seconds']),
+                datetime.fromisoformat(policy['approval_expires']), datetime.fromisoformat(policy['period_end'])), 'by_edge': {},
+            'diagnostics': incident_geometry_diagnostics(incidents, plan.get('chains') or [])}, upsert=True)
+    return {'accepted_points': stored, 'configured_points': len(points)}
+
+
+async def run_scheduler():
+    policy = approval()
+    if policy is None or not os.getenv('TOMTOM_TRAFFIC_API_KEY', '').strip():
+        return
+    if policy.get('storage_backend') != 'MONGO_TTL' or policy.get('backup_retention_approved') is not True:
+        return
+    from database import db
+    # Operator must explicitly approve one shared control DB across all PERIX
+    # instances/environments using this account. Other account consumers remain
+    # outside PERIX's control and require console-side monitoring/caps.
+    control_db = db.client[policy['control_database']]
+    control = TrafficControl(control_db.mobility_tomtom_control, policy)
+    client = TomTomClient(control)
+    owner = uuid.uuid4().hex
+    last_slots = None
+    await db.mobility_tomtom_evidence.create_index('expires_at', expireAfterSeconds=0)
+    while approval() == policy:
+        try:
+            lease = await control.acquire(owner)
+            if lease:
+                clock = datetime.now(timezone.utc)
+                slots = (int(clock.timestamp()) // 1200, int(clock.timestamp()) // 1800)
+                if slots == last_slots:
+                    await asyncio.sleep(30)
+                    continue
+                # Plan is own canonical configuration, never inferred from a
