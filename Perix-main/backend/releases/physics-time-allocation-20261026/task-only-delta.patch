+"""Rank actual scheduled traversals on validated directed generations only."""
+import hashlib
+from collections import Counter
+
+
+def rank_points(network, domain, bundles, *, minimum_edge_m=40.0, matched_measurements=()):
+    scope = {k: str(network.get(k) or '') for k in ('region_id', 'network_id', 'version_id')}
+    if not all(scope.values()):
+        raise ValueError('explicit network scope required')
+    templates = domain.get('trip_templates') or []
+    by_pattern = {}
+    for trip in templates:
+        by_pattern.setdefault(str(trip.get('pattern_id')), []).append(trip)
+    candidates = {}
+    total_passes = 0
+    for bundle in bundles:
+        if (not bundle.get('ready') or bundle.get('mode') != 'bus'
+                or any(str(bundle.get(k) or '') != v for k, v in scope.items())
+                or (bundle.get('geometry') or {}).get('validation', {}).get('valid') is not True):
+            continue
+        infra = bundle.get('infrastructure') or {}
+        if (infra.get('derived_generation') != bundle.get('generation_id')
+                or any(str(infra.get(k) or '') != v for k, v in scope.items())
+                or infra.get('pattern_id') != bundle.get('pattern_id')):
+            continue
+        trips = by_pattern.get(str(bundle['pattern_id']), [])
+        edges = infra.get('edges') or []
+        for index, edge in enumerate(edges):
+            if (edge.get('length_m', 0) < minimum_edge_m or not edge.get('from_point')
+                    or not edge.get('to_point') or not (edge.get('way') or {}).get('highway')):
+                continue
+            total_passes += len(trips)
+            key = (bundle['osm_snapshot_v'], str(edge['edge_id']))
+            item = candidates.setdefault(key, {'region_id': scope['region_id'], 'network_id': scope['network_id'],
+                'version_id': scope['version_id'], 'osm_snapshot_v': bundle['osm_snapshot_v'],
+                'edge_id': edge['edge_id'], 'direction': f"{edge.get('from_node')}->{edge.get('to_node')}",
+                'point': [(edge['from_point'][i] + edge['to_point'][i]) / 2 for i in (0, 1)],
+                'pattern_ids': set(), 'trip_ids': set(), 'lines': set(), 'scheduled_passes': 0,
+                'road_class': edge['way']['highway'], 'signal_events': 0, 'historical_evidence': False,
+                'generation_ids': set(), 'chains': []})
+            item['pattern_ids'].add(bundle['pattern_id'])
+            item['generation_ids'].add(bundle['generation_id'])
+            item['trip_ids'].update(str(t['trip_id']) for t in trips)
+            item['lines'].update(str(t.get('route_number') or bundle.get('route_number') or '') for t in trips)
+            item['scheduled_passes'] += len(trips)
+            item['signal_events'] = max(item['signal_events'], sum(1 for s in infra.get('signal_events', [])
+                if s.get('usable_for_motion') and abs(s['progress_m'] - edge['from_m']) <= 150))
+            # Only record a documented profile flag; absence remains unknown.
+            item['historical_evidence'] |= bool(edge.get('traffic_profile_available'))
+            # A finite, connected same-way chain, not a new inferred route.
+            lo, hi = index, index + 1
+            while lo > 0 and edges[lo-1].get('way_id') == edge.get('way_id') and edges[lo-1]['to_node'] == edges[lo]['from_node'] and edge['from_m'] - edges[lo-1]['from_m'] <= 500:
+                lo -= 1
+            while hi < len(edges) and edges[hi].get('way_id') == edge.get('way_id') and edges[hi-1]['to_node'] == edges[hi]['from_node'] and edges[hi]['to_m'] - edge['to_m'] <= 500:
+                hi += 1
+            item['chains'].append({'chain_id': str(bundle['pattern_id']) + ':' + str(index),
+                **scope, 'mode': 'bus', 'osm_snapshot_v': bundle['osm_snapshot_v'],
+                'pattern_id': bundle['pattern_id'], 'generation_id': bundle['generation_id'], 'edges': edges[lo:hi]})
+    rows = []
+    for item in candidates.values():
+        item['point_id'] = hashlib.sha256(repr((scope, item['osm_snapshot_v'], item['edge_id'])).encode()).hexdigest()[:20]
+        item['score'] = item['scheduled_passes'] + 2 * len(item['lines']) + item['signal_events'] + int(item['historical_evidence'])
+        item['score_basis'] = 'SCHEDULED_PASSES_LINES_SIGNALS_HISTORY_NOT_MEASURED_COVERAGE'
+        for key in ('pattern_ids', 'generation_ids', 'trip_ids', 'lines'):
+            item[key] = sorted(item[key])
+        rows.append(item)
+    rows.sort(key=lambda r: (-r['score'], r['point_id']))
+    measurements = [r for r in matched_measurements if all(str(r.get(k) or '') == v for k,v in scope.items())]
+    matched_edges = {(r['osm_snapshot_v'],r['edge_id']) for r in rows for m in measurements
+        if m.get('osm_snapshot_v') == r['osm_snapshot_v']
+        and set(m.get('generation_ids', [])).intersection(r['generation_ids'])
+        and r['edge_id'] in m.get('by_edge', {})}
+    covered_passes = sum(r['scheduled_passes'] for r in rows if (r['osm_snapshot_v'],r['edge_id']) in matched_edges)
+    return {'scope': scope, 'service_date': network.get('service_date'),
+            'candidate_edge_passes': total_passes, 'scheduled_trip_count': len({t['trip_id'] for t in templates}),
+            'scheduled_bus_trip_count': len({t['trip_id'] for t in templates if t.get('mode') == 'bus'}),
+            'matched_tomtom_measurements': sum(any((m.get('osm_snapshot_v'),e) in matched_edges for e in m.get('by_edge', {})) for m in measurements),
+            'direct_traffic_coverage': covered_passes / total_passes if total_passes else 0.,
+            'direct_coverage_denominator': 'ELIGIBLE_SCHEDULED_EDGE_PASSES', 'ranked': rows}
+
+
+def choose_points(report, count=6):
+    """Greedy marginal journey coverage with spatial/road diversity tie-breaks.
+
+    No enforced 4+2 split: a rotating benefit cannot be proven without a time
+    horizon/repeated observations. Start with measured ranking, keep stable IDs.
+    """
+    pending = list(report['ranked'])
+    selected, covered, classes = [], set(), Counter()
+    while pending and len(selected) < min(6, count):
+        def utility(row):
+            near = any(abs(row['point'][0] - p['point'][0]) < .002
+                       and abs(row['point'][1] - p['point'][1]) < .002 for p in selected)
+            return (len(set(row['trip_ids']) - covered), not near,
+                    classes[row['road_class']] == 0, row['score'])
+        best = max(pending, key=utility)
+        pending.remove(best)
+        selected.append({**best, 'role': 'FIXED', 'selection_reason': 'MARGINAL_SCHEDULED_COVERAGE_WITH_DIVERSITY'})
+        covered.update(best['trip_ids'])
+        classes[best['road_class']] += 1
+    total = report.get('scheduled_bus_trip_count', report['scheduled_trip_count'])
+    return {'points': selected, 'scheduled_potential_trip_coverage': len(covered) / total if total else None,
+            'scheduled_trips_covered': len(covered), 'scheduled_trip_count': total,
+            'coverage_denominator': 'SCHEDULED_BUS_TRIPS', 'network_scheduled_trip_count': report['scheduled_trip_count'],
+            'direct_measured_coverage': report['direct_traffic_coverage'],
+            'rotation_decision': 'NOT_JUSTIFIED_WITHOUT_REPEATED_MATCHED_OBSERVATIONS',
+            'rotation_min_window_seconds': 3600, 'no_random_coordinates': True}
+
+
+def validate_plan(plan, network, domain, bundles):
+    """Verify configured points against the current actual canonical ranking."""
+    ranked = rank_points(network, domain, bundles)
+    by_id = {p['point_id']: p for p in ranked['ranked']}
+    points, chains = [], {}
+    for requested in plan.get('points', []):
+        canonical = by_id.get(requested.get('point_id'))
+        if not canonical or canonical['point'] != requested.get('point'):
+            raise ValueError('point is not from active validated geometry')
+        if requested.get('role', 'FIXED') != 'FIXED':
+            raise ValueError('rotation requires a separately reviewed coverage evaluation')
+        chain = canonical['chains'][0]
+        points.append({**canonical, 'chain_id': chain['chain_id'],
+            'approved_openlr': requested.get('approved_openlr'),
+            'direction_verification_ref': requested.get('direction_verification_ref')})
+        for candidate in ranked['ranked']:
+            for c in candidate['chains']:
+                chains[c['chain_id']] = c
+    if not 1 <= len(points) <= 6 or len({p['point_id'] for p in points}) != len(points):
+        raise ValueError('invalid sampling count')
+    # Existing region order is south,west,north,east; API order is lon,lat.
+    from mobility.regions import get_region
+    south, west, north, east = get_region(network['region_id']).bbox
+    return {'points': points, 'chains': list(chains.values()), 'incident_bbox': [west, south, east, north]}
