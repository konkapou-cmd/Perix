+"""License/activation-gated TomTom v4/v5 adapter. No vehicle-poll HTTP calls.
+
+No rights are inferred from a key or public documentation. Until explicit
+approval, only synthetic test fixtures may enter parsing/matching functions.
+"""
+import asyncio
+from datetime import datetime, timezone
+import hashlib
+import http.client
+import json
+import math
+import os
+from urllib.parse import urlencode
+
+FLOW_PATH = '/traffic/services/4/flowSegmentData/absolute/{zoom}/json'
+INCIDENT_PATH = '/traffic/services/5/incidentDetails'
+INCIDENT_FIELDS = '{incidents{type,geometry{type,coordinates},properties{id,iconCategory,startTime,endTime,timeValidity,delay}}}'
+CATEGORIES = {0: 'Unknown', 1: 'Accident', 2: 'Fog', 3: 'DangerousConditions', 4: 'Rain',
+              5: 'Ice', 6: 'Jam', 7: 'LaneClosed', 8: 'RoadClosed', 9: 'RoadWorks',
+              10: 'Wind', 11: 'Flooding', 14: 'BrokenDownVehicle'}
+RIGHTS = ('commercial_prediction', 'osm_combination', 'google_maps_combination',
+          'temporary_storage', 'derived_diagnostics', 'derived_motion_state')
+
+
+def flag(name, default='false'):
+    return os.getenv(name, default).lower() == 'true'
+
+
+def approval(now=None):
+    """Fail closed, including unverified quota-renewal/account scope/retention."""
+    if not flag('MOBILITY_TOMTOM_ENABLED') or not flag('MOBILITY_TOMTOM_LICENSE_APPROVED'):
+        return None
+    now = now or datetime.now(timezone.utc)
+    try:
+        value = json.loads(os.getenv('MOBILITY_TOMTOM_APPROVAL_JSON', '{}'))
+        if (not all(value.get(k) is True for k in RIGHTS)
+                or value.get('activation_approved') is not True
+                or value.get('billing_period_verified') is not True
+                or value.get('free_tier_verified') is not True
+                or value.get('shared_budget_scope_confirmed') is not True
+                or value.get('storage_backend') != 'MONGO_TTL'
+                or value.get('backup_retention_approved') is not True
+                or value.get('asynchronous_ttl_cleanup_approved') is not True
+                or not value.get('control_database')
+                or not value.get('review_reference') or not value.get('account_ref')):
+            return None
+        start, end, expiry = [datetime.fromisoformat(value[k]) for k in ('period_start', 'period_end', 'approval_expires')]
+        if (any(d.utcoffset() is None for d in (start, end, expiry))
+                or not start <= now < min(end, expiry) or not 0 < (end - start).total_seconds() <= 32 * 86400):
+            return None
+        retention = value.get('retention_seconds')
+        if type(retention) is not int or not 0 < retention <= 1200:
+            return None
+        for kind, cap in (('flow', 15000), ('incident', 2000)):
+            requested = int(os.getenv('TOMTOM_' + kind.upper() + '_MONTHLY_HARD_CAP', str(cap)))
+            remaining = value.get('verified_remaining_' + kind + '_requests')
+            if type(remaining) is not int or remaining < 0:
+                return None
+            value[kind + '_cap'] = max(0, min(cap, requested, remaining))
+        return value
+    except (ValueError, TypeError, KeyError, OverflowError):
+        return None
+
+
+def number(value, minimum=0):
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < minimum:
+        raise ValueError('invalid numeric evidence')
+    return float(value)
+
+
+def parse_flow(payload):
+    data = payload['flowSegmentData']
+    points = [(number(p['latitude'], -90), number(p['longitude'], -180))
+              for p in data['coordinates']['coordinate']]
+    if not 2 <= len(points) <= 1000 or any(abs(a) > 85 or abs(b) > 180 for a, b in points):
+        raise ValueError('unsupported geometry')
+    out = {name: number(data[name]) for name in ('currentSpeed', 'freeFlowSpeed', 'currentTravelTime', 'freeFlowTravelTime', 'confidence')}
+    if out['confidence'] > 1 or type(data['roadClosure']) is not bool:
+        raise ValueError('invalid flow confidence/closure')
+    if out['freeFlowSpeed'] <= 0 or out['currentTravelTime'] <= 0 or out['freeFlowTravelTime'] <= 0:
+        raise ValueError('invalid flow duration')
+    return {**out, 'roadClosure': data['roadClosure'], 'points': points,
+            'openlr': data.get('openlr'), 'source_observed_at': None}
+
+
+def parse_incidents(payload, now):
+    if not isinstance(payload, dict) or not isinstance(payload.get('incidents'), list):
+        return []
+    out = []
+    for feature in payload.get('incidents', [])[:1000]:
+        try:
+            prop, geo = feature['properties'], feature['geometry']
+            category = prop['iconCategory']
+            if type(category) is not int or category not in CATEGORIES or prop.get('timeValidity') != 'present':
+                continue
+            for key, future in (('startTime', True), ('endTime', False)):
+                if prop.get(key):
+                    clock = datetime.fromisoformat(prop[key].replace('Z', '+00:00'))
+                    if clock.utcoffset() is None or (future and clock > now) or (not future and clock <= now):
+                        raise ValueError('not a current incident')
+            coords = geo['coordinates'] if geo['type'] == 'LineString' else [geo['coordinates']] if geo['type'] == 'Point' else []
+            points = [(number(p[1], -90), number(p[0], -180)) for p in coords]
+            if not points or any(abs(a) > 85 or abs(b) > 180 for a, b in points):
+                continue
+            out.append({'provider': 'TOMTOM_INCIDENT', 'category': CATEGORIES[category],
+                'incident_id': str(prop.get('id') or ''), 'points': points,
+                'motion_effect': 'NONE', 'reason': 'INCIDENT_IS_NOT_BUS_DELAY_OR_DIRECTION_PROOF'})
+        except (ValueError, KeyError, TypeError, IndexError):
+            continue
+    return out
+
+
+def _project(points, point):
+    """Finite-chain projection; caller checks every vertex and both directions."""
+    scale = 111320 * math.cos(math.radians(point[0]))
+    best, along, cumulative = math.inf, 0., 0.
+    for a, b in zip(points, points[1:]):
+        ax, ay = (a[1] - point[1]) * scale, (a[0] - point[0]) * 110540
+        bx, by = (b[1] - point[1]) * scale, (b[0] - point[0]) * 110540
+        dx, dy = bx - ax, by - ay
+        length = math.hypot(dx, dy)
+        ratio = max(0., min(1., -(ax * dx + ay * dy) / (length * length))) if length else 0.
+        distance = math.hypot(ax + ratio * dx, ay + ratio * dy)
+        if distance < best:
+            best, along = distance, cumulative + ratio * length
+        cumulative += length
+    return best, along
+
+
+def incident_geometry_diagnostics(incidents, chains, max_distance_m=15.):
+    """Associate geometry, but never infer travel direction/closure from it."""
+    out = []
+    for incident in incidents:
+        candidates = set()
+        points = incident['points']
+        if len(points) >= 2:
+            for chain in chains:
+                edges = chain.get('edges') or []
+                if chain.get('mode') != 'bus' or not edges:
+                    continue
+                canonical = [edges[0]['from_point']] + [e['to_point'] for e in edges]
+                if all(_project(canonical, p)[0] <= max_distance_m for p in points):
+                    candidates.update(str(e['edge_id']) for e in edges
+                        if _project(points, e['from_point'])[0] <= max_distance_m
+                        and _project(points, e['to_point'])[0] <= max_distance_m)
+        out.append({'source':'TOMTOM_INCIDENT','category':incident['category'],
+                    'candidate_edge_ids':sorted(candidates),'motion_effect':'NONE',
+                    'reason':'DIRECTION_UNVERIFIED' if candidates else 'GEOMETRY_UNMATCHED_OR_POINT_ONLY'})
+    return out
+
+
+def match_flow(flow, point, alternatives, *, max_distance_m=15., min_confidence=.7):
+    """Reject parallel/wrong-direction/ambiguous chains, never nearest-point only.
+
+    v4 documents shifted visualization geometry, not unambiguous heading proof.
+    Require a separately reviewed OpenLR-direction binding before using flow.
+    Geometry order is an additional compatibility check, NOT that proof itself.
+    """
+    if (not math.isfinite(max_distance_m) or not 0 < max_distance_m <= 50
+            or not math.isfinite(min_confidence) or not 0 <= min_confidence <= 1):
+        return {}, 'INVALID_MATCHING_CRITERIA'
+    if flow['confidence'] < min_confidence:
+        return {}, 'LOW_CONFIDENCE'
+    if (not point.get('direction_verification_ref') or not point.get('approved_openlr')
+            or flow.get('openlr') != point['approved_openlr']):
+        return {}, 'DIRECTION_NOT_VERIFIED'
+    if flow['roadClosure'] or flow['currentSpeed'] <= 0:
+        return {}, 'CLOSURE_OR_STOPPED_FLOW_REQUIRES_OPERATOR_REVIEW'
+    if flow['currentSpeed'] > flow['freeFlowSpeed'] or flow['currentTravelTime'] < flow['freeFlowTravelTime']:
+        return {}, 'INCONSISTENT_FLOW'
+    accepted = []
+    for chain in alternatives:
+        if (chain.get('mode') != 'bus' or chain.get('osm_snapshot_v') != point.get('osm_snapshot_v')
+                or chain.get('region_id') != point.get('region_id') or chain.get('network_id') != point.get('network_id')
+                or chain.get('version_id') != point.get('version_id')):
+            continue
+        edges = chain.get('edges') or []
+        if not edges or any(a.get('to_node') != b.get('from_node') for a, b in zip(edges, edges[1:])):
+            continue
+        canonical = [edges[0]['from_point']] + [e['to_point'] for e in edges]
+        lat_pad = max_distance_m / 110540
+        lon_pad = max_distance_m / (111320 * math.cos(math.radians(flow['points'][0][0])))
+        if (min(p[0] for p in flow['points']) < min(p[0] for p in canonical)-lat_pad
+                or max(p[0] for p in flow['points']) > max(p[0] for p in canonical)+lat_pad
+                or min(p[1] for p in flow['points']) < min(p[1] for p in canonical)-lon_pad
+                or max(p[1] for p in flow['points']) > max(p[1] for p in canonical)+lon_pad):
+            continue
+        projections = [_project(canonical, p) for p in flow['points']]
+        if max(d for d, _ in projections) > max_distance_m:
+            continue
+        progress = [p for _, p in projections]
+        if progress[-1] <= progress[0] or any(b + .5 < a for a, b in zip(progress, progress[1:])):
+            continue
+        matched = [e for e in edges if _project(flow['points'], e['from_point'])[0] <= max_distance_m
+                   and _project(flow['points'], e['to_point'])[0] <= max_distance_m
+                   and _project(flow['points'], e['from_point'])[1] < _project(flow['points'], e['to_point'])[1]]
+        accepted.append((chain, {str(e['edge_id']) for e in matched}))
+    target = next((ids for chain, ids in accepted if chain.get('chain_id') == point.get('chain_id')), set())
+    if not target:
+        return {}, 'GEOMETRY_OR_DIRECTION_MISMATCH'
+    if any(ids and not ids.intersection(target) for _, ids in accepted):
+        return {}, 'AMBIGUOUS_PARALLEL_ROAD'
+    return {edge_id: {'provider': 'TOMTOM_FLOW', 'source': 'TOMTOM_FLOW',
+                'expected_speed_kmh': flow['currentSpeed'], 'free_flow_speed_kmh': flow['freeFlowSpeed'],
+                'confidence': flow['confidence'], 'constraint': 'EVIDENCE_ONLY',
+                'includes_signal_delay': True, 'reason': 'DIRECTED_GEOMETRY_AND_REVIEWED_OPENLR',
+                'source_observed_at': None, 'age_basis': 'RECEIPT_ONLY'} for edge_id in target}, 'ACCEPTED'
+
+
+async def safe_http(path, params, key):
+    """stdlib transport does not log authenticated URLs; no redirects/retries.
+
+    Exceptions/payloads never escape to logs or API diagnostics. Count is
+    reserved before entering this function, even for timeout/cancellation.
+    """
+    def run():
+        connection = http.client.HTTPSConnection('api.tomtom.com', timeout=5)
+        try:
+            connection.set_debuglevel(0)
+            connection.request('GET', path + '?' + urlencode({**params, 'key': key}))
+            response = connection.getresponse()
+            raw = response.read(1024 * 1024 + 1)
+            if len(raw) > 1024 * 1024:
+                return 0, None
+            return response.status, json.loads(raw) if response.status == 200 else None
+        except Exception:
+            return 0, None
+        finally:
+            connection.close()
+    return await asyncio.to_thread(run)
+
+
+class TomTomClient:
+    def __init__(self, control, transport=safe_http):
+        self.control, self.transport = control, transport
+
+    async def request(self, lease, kind, params, slot):
+        policy = approval()
+        if policy is None or policy != self.control.policy:
+            return None, 'DISABLED_OR_UNAPPROVED'
+        key = os.getenv('TOMTOM_TRAFFIC_API_KEY', '').strip()
+        if not key:
+            return None, 'NO_CREDENTIAL'
+        if kind == 'flow':
+            path = FLOW_PATH.format(zoom=18)
+            try:
+                lat, lon = map(float, params['point'].split(','))
+                if not math.isfinite(lat) or not math.isfinite(lon) or not -85 <= lat <= 85 or not -180 <= lon <= 180:
+                    return None, 'INVALID_POINT'
+            except (ValueError, KeyError, AttributeError):
+                return None, 'INVALID_POINT'
+            params = {'point': params['point'], 'unit': 'kmph', 'openLr': 'true'}
