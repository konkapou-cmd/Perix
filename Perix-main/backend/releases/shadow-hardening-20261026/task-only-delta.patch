+"""Exact per-call computation reuse, not another traffic/history cache."""
+from copy import deepcopy
+from unittest.mock import Mock
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+from mobility.motion.bus_time_evidence import compare
+from test_bus_temporal_position import model
+
+
+def without_counts(report):
+    result=deepcopy(report);result.pop('computation',None)
+    return result
+
+
+@pytest.mark.parametrize('trend', [False,True])
+def test_memo_and_reference_return_identical_states_residuals_and_fallbacks(trend):
+    config,infra,builder,baseline,direct=model()
+    if trend:
+        direct['jam']['temporal_change']={'supported':True,'modeled_rate_kmh_per_second':-.01}
+    args=dict(infra=infra,start_m=0.,end_m=1000.,evidence=direct,elapsed_s=100.,physics_config=config)
+    reference=compare(baseline,baseline,builder,300.,**args,memoize=False)
+    spy=Mock(side_effect=builder)
+    cached=compare(baseline,baseline,spy,300.,**args)
+    assert without_counts(cached)==without_counts(reference)
+    assert cached['computation']['memo_hits']>0
+    assert cached['computation']['rebuild_executed']==spy.call_count
+    assert cached['computation']['rebuild_executed']<reference['computation']['rebuild_executed']
+    assert cached['construction_checks']['physics_violations']==0
+
+
+def test_memo_does_not_cross_comparisons_observations_or_targets():
+    config,infra,builder,baseline,direct=model()
+    spy=Mock(side_effect=builder)
+    args=dict(infra=infra,start_m=0.,end_m=1000.,evidence=direct,physics_config=config)
+    first=compare(baseline,baseline,spy,300.,**args)
+    original_calls=spy.call_count
+    again=compare(baseline,baseline,spy,300.,**args)
+    assert spy.call_count==2*original_calls
+    assert first==again
+    direct['jam']['expected_speed_kmh']=4.
+    changed=compare(baseline,baseline,spy,300.,**args)
+    plain=compare(baseline,baseline,builder,300.,**args,memoize=False)
+    assert without_counts(changed)==without_counts(plain)
+    assert changed['reason']!=first['reason']
+
+
+def test_non_json_metadata_bypasses_memo_without_affecting_physics():
+    config,infra,builder,baseline,direct=model()
+    direct['jam']['opaque_metadata']=object()
+    args=dict(infra=infra,start_m=0.,end_m=1000.,evidence=direct,physics_config=config)
+    cached=compare(baseline,baseline,builder,300.,**args)
+    reference=compare(baseline,baseline,builder,300.,**args,memoize=False)
+    assert without_counts(cached)==without_counts(reference)
+
+
+def test_matches_recorded_pre_hardening_implementation():
+    root=Path(r'C:\Users\PC\AppData\Local\Temp\opencode\perix-shadow-cache-baseline-20261026')
+    path=root/'Perix-main/backend/mobility/motion/bus_time_evidence.py'
+    if not path.exists():
+        pytest.skip('local pre-hardening snapshot unavailable')
+    spec=importlib.util.spec_from_file_location('pre_memo_bus_time_evidence',path)
+    old=importlib.util.module_from_spec(spec);spec.loader.exec_module(old)
+    config,infra,builder,baseline,direct=model()
+    args=dict(infra=infra,start_m=0.,end_m=1000.,evidence=direct,elapsed_s=100.,physics_config=config)
+    assert without_counts(compare(baseline,baseline,builder,300.,**args))==old.compare(baseline,baseline,builder,300.,**args)
