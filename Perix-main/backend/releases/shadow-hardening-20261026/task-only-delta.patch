+"""Paired synthetic CPU benchmark; exact outputs, no API/key/provider access."""
+from pathlib import Path
+import argparse,json,statistics,sys,time
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from mobility.motion import bus,engine,bus_time_evidence
+from mobility.motion.config import motion_config_for
+
+
+def run(iterations=40):
+    config=motion_config_for('bus')
+    edges=[dict(edge_id='free',from_node=1,to_node=2,from_m=0.,to_m=700.,from_point=[52.,11.],to_point=[52.,11.0102],
+        way={'highway':'primary','maxspeed_kmh':50.}),dict(edge_id='jam',from_node=2,to_node=3,from_m=700.,to_m=1000.,
+        from_point=[52.,11.0102],to_point=[52.,11.0146],way={'highway':'primary','maxspeed_kmh':50.})]
+    args=dict(edges=edges,signals=[],end_m=1000.,departure_service_s=0.,config=config)
+    def builder(scenario,evidence):
+        return bus.build_bus_leg(**args,traffic_by_edge=evidence,start_m=scenario.get('candidate_start_m',0.),
+            initial_speed_kmh=scenario.get('candidate_initial_speed_kmh',0.),scenario=scenario,
+            recovery_ratio=scenario.get('candidate_recovery_ratio',0.))
+    baseline=engine._fit_leg(lambda r:bus.build_bus_leg(**args,traffic_by_edge={},start_m=0.,recovery_ratio=r),300.,10)
+    timings={False:[],True:[]};counts={False:[],True:[]};hits=[]
+    for index in range(iterations+2):
+        evidence={'jam':{'provider':'TOMTOM_FLOW','expected_speed_kmh':6.,'free_flow_speed_kmh':50.,'direction_binding_id':'SYNTHETIC_ONLY'}}
+        if index%2:
+            evidence['jam']['temporal_change']={'supported':True,'modeled_rate_kmh_per_second':-.01}
+        pair={}
+        for memo in ([False,True] if index%2 else [True,False]):
+            start=time.perf_counter()
+            report=bus_time_evidence.compare(baseline,baseline,builder,300.,infra={'edges':edges,'signals':[]},
+                start_m=0.,end_m=1000.,evidence=evidence,elapsed_s=100.,physics_config=config,memoize=memo)
+            elapsed=(time.perf_counter()-start)*1000
+            computation=report.pop('computation');pair[memo]=report
+            if index>=2:
+                timings[memo].append(elapsed);counts[memo].append(computation['rebuild_executed'])
+                if memo:hits.append(computation['memo_hits'])
+        assert pair[False]==pair[True], 'memo changed model output'
+    def summary(values):
+        return {'p50':statistics.median(values),'p95':sorted(values)[int(.95*(len(values)-1))]}
+    reference=summary(timings[False]);optimized=summary(timings[True])
+    return {'type':'PAIRED_SYNTHETIC_CPU_NOT_API_LATENCY_OR_ACCURACY','paired_cases':iterations,
+        'reference_cpu_ms':reference,'memo_cpu_ms':optimized,
+        'reference_mean_rebuilds':statistics.mean(counts[False]),'memo_mean_rebuilds':statistics.mean(counts[True]),
+        'mean_exact_memo_hits':statistics.mean(hits),'all_model_outputs_identical':True,
+        'retained_phase_limit':4096,'memo_lifetime':'ONE_SYNCHRONOUS_COMPARISON_ONLY',
+        'provider_requests':0,'independent_accuracy':None,'actual_api_latency':None,
+        'p50_reduction_percent':100*(1-optimized['p50']/reference['p50']),
+        'p95_reduction_percent':100*(1-optimized['p95']/reference['p95'])}
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser();parser.add_argument('--output',required=True);args=parser.parse_args()
+    out=Path(args.output)
+    if out.exists():raise ValueError('refusing overwrite')
+    result=run();out.parent.mkdir(parents=True,exist_ok=True);out.write_text(json.dumps(result,indent=2))
+    print(json.dumps(result,indent=2))
