+import { Text, View } from "react-native";
+import { useTranslation } from "react-i18next";
+import type { TimingEvidence } from "../../lib/api/mobility";
+
+export default function MobilityTimingEvidence({ estimated, evidence }: {
+  estimated: boolean; evidence?: TimingEvidence | null;
+}) {
+  const { t } = useTranslation();
+  if (!estimated) return null;
+  const basis = evidence?.timing_basis;
+  const propagated = basis === "PROPAGATED_STOP_DEPARTURE";
+  const schedule = basis === "SCHEDULE" || basis === "NO_DATA";
+  return <View style={{ paddingVertical: 6 }} accessibilityLiveRegion="polite">
+    <Text style={{ color: "#52636A", fontSize: 12 }}>
+      {t("mobility.modelPositionNotGps", "Position estimate — not GPS.")}
+      {propagated ? ` ${t("mobility.timingFromLastDeparture", "Timing carried from the last available stop departure")}${evidence?.anchor_stop_name ? ` (${evidence.anchor_stop_name})` : ""}${typeof evidence?.timing_anchor_delay_seconds === "number" ? `: ${evidence.timing_anchor_delay_seconds > 0 ? "+" : ""}${evidence.timing_anchor_delay_seconds}s` : ""}.`
+        : basis === "FROM_DEPARTURE_UPDATE" || (schedule && evidence?.departure_timing_basis === "DIRECT_STOP_UPDATE")
+          ? ` ${t("mobility.arrivalInferredFromDeparture", "Provider departure timing is available; arrival is inferred, not directly reported.")}`
+          : schedule ? ` ${t("mobility.scheduleTimingOnly", "Schedule timing; no usable realtime update for this stop.")}`
+          : basis === "DIRECT_STOP_UPDATE" || basis === "STOP_DELAY" ? ` ${t("mobility.directStopTiming", "Provider timing for this stop; the position remains modelled.")}`
+            : basis === "TRIP_DELAY" ? ` ${t("mobility.tripWideTiming", "Trip-wide delay, not a direct update for this stop.")}` : ""}
+    </Text>
+    {evidence?.source_correction ? <Text style={{ color: "#52636A", fontSize: 12, marginTop: 3 }}>
+      {t("mobility.sourceEstimateRevised", "Estimated position recomputed after a source timing change.")}
+    </Text> : null}
+    {evidence?.timing_order_adjusted ? <Text style={{ color: "#52636A", fontSize: 12, marginTop: 3 }}>
+      {t("mobility.sourceTimingOrderConflict", "Provider timings conflict in stop order; the position is uncertain.")}
+    </Text> : null}
+    {evidence?.position_assurance === "LEGACY_FALLBACK_UNCERTAIN" ? <Text style={{ color: "#52636A", fontSize: 12, marginTop: 3 }}>
+      {t("mobility.legacyPositionUncertain", "Fallback position estimate: revised timing may not match the marker. Position is uncertain.")}
+    </Text> : null}
+    {evidence?.source_status === "TRIP_CLOCK_UNKNOWN" ? <Text style={{ color: "#52636A", fontSize: 12, marginTop: 3 }}>
+      {t("mobility.tripUpdateTimeUnknown", "Provider trip-update time unavailable; feed age is not a GPS observation.")}
+    </Text> : null}
+  </View>;
+}
