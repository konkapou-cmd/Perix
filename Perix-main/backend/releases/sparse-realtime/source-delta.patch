+import type { TimingEvidence } from "./api/mobility";
+
+/** A source-derived fallback is not a direct provider stop timestamp. */
+export function timingSourceCaption(evidence?: TimingEvidence | null, legacySource?: string) {
+  switch (evidence?.timing_basis) {
+    case "DIRECT_STOP_UPDATE": case "STOP_DELAY": return "Provider";
+    case "PROPAGATED_STOP_DEPARTURE": case "FROM_DEPARTURE_UPDATE": return "RT-derived";
+    case "TRIP_DELAY": return "Trip realtime delay";
+    case "SCHEDULE": case "NO_DATA": case "SKIPPED": return "Schedule";
+    default: return legacySource === "REALTIME" ? "Provider" : legacySource === "SCHEDULE" ? "Schedule" : "Source-derived";
+  }
+}
