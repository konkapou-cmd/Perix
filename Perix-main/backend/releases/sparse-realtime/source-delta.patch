+      latitude: p.lat, longitude: p.lng, path: points, progressM, estimateRevision, heading: 0, speed: 20, motionState: 'MOVING' };
+  };
+  return { page, sample, advance: () => { now += 1000; } };
+}
+
+test('a virtual source revision resamples the same canonical marker instead of animating backwards or preserving a wrong lead', () => {
+  const { page, sample, advance } = mapPage();
+  page.drawVehicles([sample(200, 'epoch:old')]); const marker = page.VEHICLES['actual-source'].marker;
+  advance();
+  page.drawVehicles([sample(50, 'epoch:corrected')]); const rec = page.VEHICLES['actual-source'];
+  assert.equal(rec.marker, marker); assert.equal(rec.journeyId, 'dated:T');
+  assert.equal(rec.progNow, 50); assert.equal(rec.animStart, null);
+  assert.equal(marker.position.lat, sample(50).latitude);
+  advance(); page.drawVehicles([sample(70, 'epoch:corrected')]);
+  assert.equal(rec.progFrom, 50); assert.equal(rec.progTo, 70);
+});
+
+test('same-revision jitter retains the old no-reverse rule; GPS ignores virtual revision tokens', () => {
+  const h = mapPage(); h.page.drawVehicles([h.sample(200, 'epoch:one')]);
+  h.advance();
+  h.page.drawVehicles([h.sample(150, 'epoch:one')]);
+  assert.equal(h.page.VEHICLES['actual-source'].progNow, 200);
+  const gps = mapPage(); gps.page.drawVehicles([gps.sample(200, 'not-a-gps-revision', false)]);
+  gps.advance();
+  gps.page.drawVehicles([gps.sample(150, 'another-virtual-token', false)]);
+  assert.equal(gps.page.VEHICLES['actual-source'].estimateRevision, null);
+  assert.equal(gps.page.VEHICLES['actual-source'].progNow, 200);
+});
+
+test('bridge sends only small revision metadata when source timing changes, never reserializing static geometry', () => {
+  const { vehicleBridgeUpdates } = load('lib/vehicleBridge.ts');
+  const v = { id: 'actual-source', journeyId: 'dated:T', estimated: true, latitude: 52, longitude: 11,
+    path: [{ latitude: 52, longitude: 11 }, { latitude: 53, longitude: 11 }], estimateRevision: 'epoch:old' };
+  const first = vehicleBridgeUpdates([v], new Map());
