+        return {
+            "available": False,
+            "trip_id": str(trip_id),
+            "route_number": route.get("route_number"),
+            "fallback_reason": "TIMELINE_NOT_AVAILABLE",
+            "legs": [],
+        }
+
+    path = await _trip_path_geometry(route, trip, timeline)
+    if not path:
