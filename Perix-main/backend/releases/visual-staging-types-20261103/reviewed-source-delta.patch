+            "available": False,
+            "trip_id": str(trip_id),
+            "route_number": route.get("route_number"),
+            "fallback_reason": "NO_CANONICAL_PATH",
+            "legs": [],
+        }
+
+    report = await explain_trip_plan(
+        trip_id=str(trip_id),
+        mode=str(route.get("mode") or "bus"),
+        version_id=str(network.get("version_id") or ""),
+        timeline=timeline,
+        path=path,
+    )
+    return {
