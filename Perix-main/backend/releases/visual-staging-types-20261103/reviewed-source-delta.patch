+def _shape_index_for(shape: List[list], lat: float, lng: float) -> int:
+    best_i, best_d = 0, float("inf")
+    for i, pt in enumerate(shape):
+        d = _haversine_km(lat, lng, pt[0], pt[1])
+        if d < best_d:
+            best_d, best_i = d, i
