# Perix Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# Backend API URL
EXPO_PUBLIC_BACKEND_URL=http://10.22.201.177:8000

# Google Maps API Key (get from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Google Maps JavaScript API key (used by the Mobility map iframe/WebView).
# Falls back to EXPO_PUBLIC_GOOGLE_MAPS_API_KEY when unset.
EXPO_PUBLIC_GOOGLE_MAPS_JS_KEY=YOUR_GOOGLE_MAPS_JS_KEY

# Agora App ID (get from Agora Console)
EXPO_PUBLIC_AGORA_APP_ID=YOUR_AGORA_APP_ID

# Firebase Cloud Messaging (server key - for push notifications)
# This is used server-side only, do not expose to client
FCM_SERVER_KEY=YOUR_FCM_SERVER_KEY

# Mobility map page URL (served by the frontend, not the backend API)
EXPO_PUBLIC_MOBILITY_MAP_URL=https://YOUR-VERIFIED-STAGING-FRONTEND/google-mobility-map.html

# Approved Mobility map origins (comma-separated, exact HTTPS origins)
EXPO_PUBLIC_MOBILITY_MAP_ORIGINS=https://YOUR-VERIFIED-STAGING-FRONTEND
