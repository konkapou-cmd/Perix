FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/ ./scripts/
RUN npm ci
COPY . .
ARG EXPO_PUBLIC_BACKEND_URL
ARG EXPO_PUBLIC_GOOGLE_MAPS_JS_KEY
ARG EXPO_PUBLIC_GOOGLE_MAPS_API_KEY
ARG EXPO_PUBLIC_MOBILITY_MAP_URL
ARG EXPO_PUBLIC_MOBILITY_MAP_ORIGINS
ENV EXPO_PUBLIC_BACKEND_URL=$EXPO_PUBLIC_BACKEND_URL
ENV EXPO_PUBLIC_GOOGLE_MAPS_JS_KEY=$EXPO_PUBLIC_GOOGLE_MAPS_JS_KEY
ENV EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY
ENV EXPO_PUBLIC_MOBILITY_MAP_URL=$EXPO_PUBLIC_MOBILITY_MAP_URL
ENV EXPO_PUBLIC_MOBILITY_MAP_ORIGINS=$EXPO_PUBLIC_MOBILITY_MAP_ORIGINS
RUN node scripts/patch-reanimated.js && EXPO_NO_MINIFY=1 npx expo export --platform web --clear

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
