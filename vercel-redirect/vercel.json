{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^perix\\.eu$"
        }
      ],
      "destination": "https://app.perix.eu/app",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^www\\.perix\\.eu$"
        }
      ],
      "destination": "https://app.perix.eu/app",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^perix\\.eu$"
        }
      ],
      "destination": "https://app.perix.eu/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^www\\.perix\\.eu$"
        }
      ],
      "destination": "https://app.perix.eu/:path*",
      "permanent": true
    }
  ]
}